{
  "name": "scraper-config-studio-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "verify:contract": "esbuild scripts/verify-contract.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-contract.mjs && node node_modules/.cache/verify-contract.mjs",
    "verify:contract-store": "esbuild scripts/verify-contract-store.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-contract-store.mjs && node node_modules/.cache/verify-contract-store.mjs"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
